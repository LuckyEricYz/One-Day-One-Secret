{
  "name": "one-day-one-secret",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node --import tsx server/dev.ts",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node --import tsx server/smoke.ts",
    "build:knowledge-index": "node --import tsx server/build-knowledge-index.ts",
    "eval:generate": "node --import tsx server/evaluate-generation.ts",
    "test:quality": "node --import tsx server/test-quality.ts",
    "ship": "node scripts/ship-issue.mjs",
